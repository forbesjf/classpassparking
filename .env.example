# Copy this file to `.env` for local development (scripts/setup.sh does this
# automatically if `.env` is missing).

# SQLite database, stored next to the Prisma schema.
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Use a long random value in production.
AUTH_SECRET="spotpass-dev-secret-change-me-please-0123456789abcdef"
