# Copy this file to `.env` for local development (scripts/setup.sh does this
# automatically if `.env` is missing).

# Postgres connection string.
#  • Local dev: run `docker compose up -d` (see docker-compose.yml) — this URL
#    matches that container out of the box.
#  • Production: use a hosted Postgres such as Neon (https://neon.tech) and
#    paste its pooled connection string here (usually ends with ?sslmode=require).
DATABASE_URL="postgresql://spotpass:spotpass@localhost:5432/spotpass?schema=public"

# Secret used to sign session JWTs. Use a long, random value in production
# (e.g. `openssl rand -hex 32`).
AUTH_SECRET="spotpass-dev-secret-change-me-please-0123456789abcdef"
